# user-defined
*.code-workspace
**/.vscode/
.mypy_cache
tags*
.DS_Store
*.plist

# configuration files
proto/python/src/soil_power_sensor_protobuf/config/Load/*.json

# docs
# The doxygen build lives under embedded/. The bare "doxygen/build" below
# predates that move and only matched a root-level directory; embedded/.gitignore
# has "Build/" which happens to catch it on case-insensitive filesystems but not
# on Linux, so name it explicitly.
doxygen/build
embedded/doxygen/build/

# cppcheck
*.ctu-info
*.dump


## Python

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
